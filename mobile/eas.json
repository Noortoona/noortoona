{
  "cli": {
    "version": ">= 24.10.0 < 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PAYMENTS_ENABLED": "false"
      }
    },
    "testflight": {
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "node": "24.19.0",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}

{
  "expo": {
    "name": "هلا",
    "slug": "hala",
    "scheme": "hala",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/hala-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noortoona.hala",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.noortoona.hala",
      "adaptiveIcon": {
        "foregroundImage": "./assets/hala-icon.png",
        "backgroundColor": "#2E0D1B"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "السماح لهلا باستخدام Face ID لحماية تسجيل الدخول."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الكاميرا لمسح رمز QR والتحقق من دخول الضيوف.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/hala-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2E0D1B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح لهلا باختيار صورة أو تصميم للدعوة.",
          "cameraPermission": "السماح لهلا بالكاميرا لمسح QR عند الاستقبال.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5aeba34d-6f95-424b-92b1-5519b5d20197"
      }
    },
    "owner": "hala.app"
  }
}

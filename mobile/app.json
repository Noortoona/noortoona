{
  "expo": {
    "name": "هلا",
    "slug": "hala",
    "scheme": "hala",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "../assets/brand/hala-icon.png",
    "splash": {
      "image": "../assets/brand/hala-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A0E1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noortoona.hala"
    },
    "android": {
      "package": "com.noortoona.hala",
      "adaptiveIcon": {
        "foregroundImage": "../assets/brand/hala-icon.png",
        "backgroundColor": "#4A0E1E"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "السماح لهلا باستخدام Face ID لحماية تسجيل الدخول."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الكاميرا لمسح رمز QR والتحقق من دخول الضيوف.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}

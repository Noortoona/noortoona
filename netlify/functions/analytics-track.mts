import type { Config } from "@netlify/functions";import { getDatabase } from "@netlify/database";import { secureJson } from "./_shared/domain.mjs";
export default async(req:Request)=>{if(req.method!=="POST")return new Response("Method Not Allowed",{status:405});try{const b:any=await req.json();const sid=String(b.sessionId||"").slice(0,80),event=String(b.event||"page_view").slice(0,80),path=String(b.path||"/").slice(0,240);if(!/^[a-zA-Z0-9_-]{12,80}$/.test(sid))return secureJson({ok:false},400);const meta=JSON.stringify(b.metadata||{}).slice(0,1500);const db=getDatabase();await db.sql`INSERT INTO page_views(id,session_id,event_name,path,metadata) VALUES(${crypto.randomUUID()},${sid},${event},${path},${meta}::jsonb)`;return secureJson({ok:true},201)}catch{return secureJson({ok:false},400)}};
export const config:Config={path:"/api/analytics/track"};